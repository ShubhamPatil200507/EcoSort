# ==========================================
# EcoSort Application Environment Variables
# ==========================================

# Application Name & Environment
ECOSORT_APP_NAME="EcoSort"
ENVIRONMENT="development"

# ML Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.50

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760

# Model Paths
MODEL_WEIGHTS_PATH="data/models/mobilenetv3_ecosort.pt"
EVAL_REPORT_PATH="data/models/evaluation_report.json"

# Geospatial Provider Configuration
# Options: "hybrid", "osm", "verified_db"
GEO_PROVIDER="hybrid"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
DEMO_MODE=false
DEFAULT_SEARCH_RADIUS_KM=15.0

# Server
PORT=8000
HOST="0.0.0.0"
